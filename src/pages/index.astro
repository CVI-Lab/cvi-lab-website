---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import HeroVisual from '../components/HeroVisual.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ResearchAreaCard from '../components/ResearchAreaCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getProjects } from '../data/content';
import { pageCopy } from '../data/page-copy';
import { researchAreas } from '../data/research';
import { site } from '../data/site';
import { withBase } from '../utils/paths';

const projects = await getProjects();
const featuredProjects = projects
  .filter((project) => project.featured)
  .sort((a, b) => (b.featuredOrder ?? 0) - (a.featuredOrder ?? 0))
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero section" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="eyebrow" data-inline-edit="site:officialName">{site.officialName}</p>
        <h1 id="hero-title" data-inline-edit="site:heroHeading">{site.heroHeading}</h1>
        <p class="hero__supporting" data-inline-edit="site:positioning">{site.positioning}</p>
        <div class="hero__actions">
          <Button href={withBase('/projects/')}>{pageCopy.home.primaryAction}</Button>
          <Button href={withBase('/publications/')} variant="secondary">{pageCopy.home.secondaryAction}</Button>
        </div>
        <dl class="hero__facts" aria-label="Lab facts">
          <div><dt data-inline-edit="pages:home.establishedLabel">{pageCopy.home.establishedLabel}</dt><dd>{site.established}</dd></div>
          <div><dt data-inline-edit="pages:home.basedAtLabel">{pageCopy.home.basedAtLabel}</dt><dd data-inline-edit="pages:home.basedAtValue">{pageCopy.home.basedAtValue}</dd></div>
          <div><dt data-inline-edit="pages:home.themesLabel">{pageCopy.home.themesLabel}</dt><dd data-inline-edit="pages:home.themesValue">{pageCopy.home.themesValue}</dd></div>
        </dl>
      </div>
      <HeroVisual />
    </div>
  </section>

  <section class="section home-intro" aria-labelledby="intro-title">
    <div class="container home-intro__grid">
      <ResponsiveImage
        src={withBase('/images/home/group-meeting-option-1.png')}
        alt="CVI Lab researchers collaborating around a table during a group meeting"
        aspect="wide"
        placeholderLabel="CVI Lab group meeting image unavailable"
      />
      <div class="home-intro__content">
        <p class="eyebrow" data-inline-edit="pages:home.introEyebrow">{pageCopy.home.introEyebrow}</p>
        <h2 id="intro-title" data-inline-edit="pages:home.introTitle">{pageCopy.home.introTitle}</h2>
        <p data-inline-edit="site:homepageIntroShort">{site.homepageIntroShort}</p>
        <a class="text-link" href={withBase('/about/')}>
          {pageCopy.home.aboutLink}
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4.5 5.5 5.5L7 15.5M12 10H3.5" /></svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="research-title">
    <div class="container">
      <SectionHeading
        id="research-title"
        eyebrow={pageCopy.home.researchEyebrow}
        title={pageCopy.home.researchTitle}
        intro={pageCopy.home.researchIntro}
        eyebrowEditKey="pages:home.researchEyebrow"
        titleEditKey="pages:home.researchTitle"
        introEditKey="pages:home.researchIntro"
      />
      <div class="research-grid">
        {researchAreas.map((area, index) => <ResearchAreaCard area={area} editPrefix={`research:${index}`} />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-heading-row">
        <SectionHeading
          id="projects-title"
          eyebrow={pageCopy.home.projectsEyebrow}
          title={pageCopy.home.projectsTitle}
          intro={pageCopy.home.projectsIntro}
          eyebrowEditKey="pages:home.projectsEyebrow"
          titleEditKey="pages:home.projectsTitle"
          introEditKey="pages:home.projectsIntro"
        />
        <a class="text-link text-link--desktop" href={withBase('/projects/')}>
          {pageCopy.home.projectsLink}
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4.5 5.5 5.5L7 15.5M12 10H3.5" /></svg>
        </a>
      </div>
      <div class="project-grid project-grid--featured">
        {featuredProjects.map((project, index) => (
          <ProjectCard project={project} priority={index === 0} orderGroup="featured-project" />
        ))}
      </div>
      <a class="text-link text-link--mobile" href={withBase('/projects/')}>
        {pageCopy.home.projectsLink}
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4.5 5.5 5.5L7 15.5M12 10H3.5" /></svg>
      </a>
    </div>
  </section>

  <section class="section join-banner-section" aria-labelledby="join-title">
    <div class="container">
      <div class="join-banner">
        <div class="join-banner__visual" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="join-banner__content">
          <p class="eyebrow" data-inline-edit="pages:home.joinEyebrow">{pageCopy.home.joinEyebrow}</p>
          <h2 id="join-title" data-inline-edit="pages:home.joinTitle">{pageCopy.home.joinTitle}</h2>
          <p data-inline-edit="site:joinShort">{site.joinShort}</p>
        </div>
        <Button href={withBase('/join/')}>{pageCopy.home.joinAction}</Button>
      </div>
    </div>
  </section>
</BaseLayout>
