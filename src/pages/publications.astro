---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationEntry from '../components/PublicationEntry.astro';
import { getPublications } from '../data/content';
import { pageCopy } from '../data/page-copy';

const publications = await getPublications();
const years = [...new Set(publications.map((publication) => publication.year))].sort((a, b) => b - a);
---

<BaseLayout title="Publications" description="Browse publications from the CVI Lab at UBC Okanagan, grouped by year.">
  <section class="page-hero page-hero--compact">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow" data-inline-edit="pages:publications.heroEyebrow">{pageCopy.publications.heroEyebrow}</p>
        <h1 data-inline-edit="pages:publications.heroTitle">{pageCopy.publications.heroTitle}</h1>
      </div>
      <p data-inline-edit="pages:publications.heroIntro">{pageCopy.publications.heroIntro}</p>
    </div>
  </section>

  <section class="section publications-page" aria-label="Publications by year">
    <div class="container">
      {years.map((year) => (
        <section class="publication-year" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <div class="publication-list">
            {publications.filter((publication) => publication.year === year).map((publication) => (
              <PublicationEntry publication={publication} orderGroup={`publication:${year}`} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
