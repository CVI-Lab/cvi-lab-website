---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlumniCard from '../components/AlumniCard.astro';
import PersonCard from '../components/PersonCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { alumni, mscStudents, phdStudents, piBiography, principalInvestigator } from '../data/people';
---

<BaseLayout title="People" description="Meet the principal investigator, students, and alumni of the CVI Lab at UBC Okanagan.">
  <section class="page-hero page-hero--compact">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow">People</p>
        <h1>Researchers learning, building, and discovering together.</h1>
      </div>
      <p>Our lab brings together researchers working across computer vision, graphics, multimodal sensing, and trustworthy artificial intelligence.</p>
    </div>
  </section>

  <section class="section people-section" aria-labelledby="people-pi-title">
    <div class="container">
      <SectionHeading eyebrow="Lab leadership" title="Principal Investigator" />
      <article class="pi-card">
        <ResponsiveImage
          src={principalInvestigator.avatar}
          alt="Illustrated portrait of Dr. Shan Du"
          aspect="square"
          placeholderLabel="PI portrait unavailable"
        />
        <div class="pi-card__content">
          <h2 id="people-pi-title">{principalInvestigator.name}</h2>
          <p class="pi-card__role">Assistant Professor, Computer Science<br />The University of British Columbia, Okanagan Campus</p>
          {piBiography.map((paragraph) => <p>{paragraph}</p>)}
          <a class="text-link" href={`mailto:${principalInvestigator.email}`}>Email Dr. Du</a>
        </div>
      </article>
    </div>
  </section>

  {phdStudents.length > 0 && (
    <section class="section section--alt people-section" aria-labelledby="phd-title">
      <div class="container">
        <SectionHeading id="phd-title" eyebrow="Current members" title="PhD Students" />
        <div class="people-grid">{phdStudents.map((person) => <PersonCard person={person} />)}</div>
      </div>
    </section>
  )}

  {mscStudents.length > 0 && (
    <section class="section people-section" aria-labelledby="msc-title">
      <div class="container">
        <SectionHeading id="msc-title" eyebrow="Current members" title="MSc Students" />
        <div class="people-grid">{mscStudents.map((person) => <PersonCard person={person} />)}</div>
      </div>
    </section>
  )}

  {alumni.length > 0 && (
    <section class="section section--alt alumni-section people-section" aria-labelledby="alumni-title">
      <div class="container">
        <SectionHeading id="alumni-title" eyebrow="Former members" title="Alumni" />
        <div class="people-grid people-grid--alumni">{alumni.map((person) => <AlumniCard alumnus={person} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>
