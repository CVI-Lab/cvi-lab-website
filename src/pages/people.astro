---
import BaseLayout from '../layouts/BaseLayout.astro';
import AlumniCard from '../components/AlumniCard.astro';
import PersonCard from '../components/PersonCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { getPeople } from '../data/content';
import { pageCopy } from '../data/page-copy';
import { withBase } from '../utils/paths';

const {
  alumni,
  mscStudents,
  phdStudents,
  piBiography,
  postdoctoralResearchers,
  principalInvestigator,
  undergraduateResearchers,
  visitingScholars,
} = await getPeople();

const currentGroups = [
  { id: 'postdoc', title: pageCopy.people.postdocTitle, titleKey: 'pages:people.postdocTitle', people: postdoctoralResearchers },
  { id: 'visiting', title: pageCopy.people.visitingTitle, titleKey: 'pages:people.visitingTitle', people: visitingScholars },
  { id: 'phd', title: pageCopy.people.phdTitle, titleKey: 'pages:people.phdTitle', people: phdStudents },
  { id: 'msc', title: pageCopy.people.mastersTitle, titleKey: 'pages:people.mastersTitle', people: mscStudents },
  { id: 'undergraduate', title: pageCopy.people.undergraduateTitle, titleKey: 'pages:people.undergraduateTitle', people: undergraduateResearchers },
].filter((group) => group.people.length > 0);

const alumniGroups = [
  {
    id: 'visiting-postdoc',
    title: pageCopy.people.alumniVisitingPostdocTitle,
    titleKey: 'pages:people.alumniVisitingPostdocTitle',
    people: alumni.filter((person) => person.category === 'visiting' || person.category === 'postdoc'),
  },
  {
    id: 'phd',
    title: pageCopy.people.alumniPhdTitle,
    titleKey: 'pages:people.alumniPhdTitle',
    people: alumni.filter((person) => person.category === 'phd'),
  },
  {
    id: 'masters',
    title: pageCopy.people.alumniMastersTitle,
    titleKey: 'pages:people.alumniMastersTitle',
    people: alumni.filter((person) => person.category === 'masters'),
  },
  {
    id: 'undergraduate',
    title: pageCopy.people.alumniUndergraduateTitle,
    titleKey: 'pages:people.alumniUndergraduateTitle',
    people: alumni.filter((person) => person.category === 'undergraduate'),
  },
].filter((group) => group.people.length > 0);
---

<BaseLayout title="People" description="Meet the principal investigator, students, and alumni of the CVI Lab at UBC Okanagan.">
  <section class="page-hero page-hero--compact">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow" data-inline-edit="pages:people.heroEyebrow">{pageCopy.people.heroEyebrow}</p>
        <h1 data-inline-edit="pages:people.heroTitle">{pageCopy.people.heroTitle}</h1>
      </div>
      <p data-inline-edit="pages:people.heroIntro">{pageCopy.people.heroIntro}</p>
    </div>
  </section>

  <section class="section people-section" aria-labelledby="people-pi-title">
    <div class="container">
      <SectionHeading
        eyebrow={pageCopy.people.leadershipEyebrow}
        title={pageCopy.people.leadershipTitle}
        eyebrowEditKey="pages:people.leadershipEyebrow"
        titleEditKey="pages:people.leadershipTitle"
      />
      <article class="pi-card" data-content-type="person" data-content-id={principalInvestigator.id}>
        <ResponsiveImage
          src={principalInvestigator.avatar}
          alt="Illustrated portrait of Dr. Shan Du"
          aspect="square"
          placeholderLabel="PI portrait unavailable"
        />
        <div class="pi-card__content">
          <h2 id="people-pi-title">{principalInvestigator.name}</h2>
          <p class="pi-card__role">{principalInvestigator.role}</p>
          {piBiography.map((paragraph) => <p>{paragraph}</p>)}
          <a class="text-link" href={withBase('/contact/')}>{pageCopy.people.contactAction}</a>
        </div>
      </article>
    </div>
  </section>

  {currentGroups.map((group, index) => (
    <section class:list={['section', 'people-section', { 'section--alt': index % 2 === 0 }]} aria-labelledby={`${group.id}-title`}>
      <div class="container">
        <SectionHeading
          id={`${group.id}-title`}
          eyebrow={pageCopy.people.currentEyebrow}
          title={group.title}
          eyebrowEditKey="pages:people.currentEyebrow"
          titleEditKey={group.titleKey}
        />
        <div class="people-grid">{group.people.map((person) => <PersonCard person={person} orderGroup={`person:current:${group.id === 'msc' ? 'masters' : group.id}`} />)}</div>
      </div>
    </section>
  ))}

  {alumni.length > 0 && (
    <section class:list={['section', 'alumni-section', 'people-section', { 'section--alt': currentGroups.length % 2 === 0 }]} aria-labelledby="alumni-title">
      <div class="container">
        <SectionHeading
          id="alumni-title"
          eyebrow={pageCopy.people.alumniEyebrow}
          title={pageCopy.people.alumniTitle}
          eyebrowEditKey="pages:people.alumniEyebrow"
          titleEditKey="pages:people.alumniTitle"
        />
        <div class="alumni-groups">
          {alumniGroups.map((group) => (
            <section class="alumni-group" aria-labelledby={`alumni-${group.id}-title`}>
              <h3 id={`alumni-${group.id}-title`} class="alumni-group__title" data-inline-edit={group.titleKey}>{group.title}</h3>
              <div class="people-grid people-grid--alumni">
                {group.people.map((person) => <AlumniCard alumnus={person} orderGroup={`person:alumni:${person.category}`} />)}
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
