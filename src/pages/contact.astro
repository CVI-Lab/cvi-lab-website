---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageCopy } from '../data/page-copy';
import { site } from '../data/site';

const inquiryTypes = pageCopy.contact.inquiries.map((inquiry, index) => ({
  ...inquiry,
  number: String(index + 1).padStart(2, '0'),
  editPrefix: `pages:contact.inquiries.${index}`,
}));
---

<BaseLayout title="Contact" description="Contact the CVI Lab regarding prospective students, research collaboration, and general inquiries.">
  <section class="page-hero page-hero--compact">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow" data-inline-edit="pages:contact.heroEyebrow">{pageCopy.contact.heroEyebrow}</p>
        <h1 data-inline-edit="pages:contact.heroTitle">{pageCopy.contact.heroTitle}</h1>
      </div>
      <p data-inline-edit="pages:contact.heroIntro">{pageCopy.contact.heroIntro}</p>
    </div>
  </section>

  <section class="section contact-section" aria-labelledby="contact-details-title">
    <div class="container contact-grid">
      <div class="contact-card">
        <p class="eyebrow" data-inline-edit="pages:contact.detailsEyebrow">{pageCopy.contact.detailsEyebrow}</p>
        <h2 id="contact-details-title" data-inline-edit="site:officialName">{site.officialName}</h2>
        <div class="contact-card__block">
          <h3 data-inline-edit="pages:contact.institutionTitle">{pageCopy.contact.institutionTitle}</h3>
          <p>
            <span data-inline-edit="site:institution">{site.institution}</span><br />
            <span data-inline-edit="site:faculty">{site.faculty}</span><br />
            <span data-inline-edit="site:department">{site.department}</span>
          </p>
        </div>
        <div class="contact-card__block">
          <h3 data-inline-edit="pages:contact.addressTitle">{pageCopy.contact.addressTitle}</h3>
          <address data-inline-edit="site:address" data-inline-format="lines">{site.address.map((line) => <>{line}<br /></>)}</address>
        </div>
        <div class="contact-card__block">
          <h3 data-inline-edit="pages:contact.emailTitle">{pageCopy.contact.emailTitle}</h3>
          <p><span data-inline-edit="pages:contact.emailName">{pageCopy.contact.emailName}</span>: <span data-inline-edit="site:email"><a href={`mailto:${site.email}`}>{site.email}</a></span></p>
        </div>
      </div>

      <div class="inquiry-list">
        {inquiryTypes.map((inquiry) => (
          <article class="inquiry-card">
            <span>{inquiry.number}</span>
            <div>
              <h2 data-inline-edit={`${inquiry.editPrefix}.title`}>{inquiry.title}</h2>
              <p data-inline-edit={`${inquiry.editPrefix}.text`}>{inquiry.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
