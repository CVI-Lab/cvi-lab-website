---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { site } from '../data/site';

const inquiryTypes = [
  {
    number: '01',
    title: 'Prospective Students',
    text: 'Prospective students should review the Join the Lab section before contacting Dr. Shan Du. Please include your intended program, research interests, relevant background, expected start date, and the requested supporting materials.',
    subject: 'Prospective student inquiry',
  },
  {
    number: '02',
    title: 'Research Collaboration',
    text: 'Academic and industry researchers are welcome to contact the lab regarding potential collaborations related to its research areas. Please include a short description of the proposed topic and the anticipated form of collaboration.',
    subject: 'Research collaboration inquiry',
  },
  {
    number: '03',
    title: 'General Inquiries',
    text: 'For other inquiries related to the laboratory, its publications, projects, or research activities, please contact Dr. Shan Du by email.',
    subject: 'CVI Lab general inquiry',
  },
];
---

<BaseLayout title="Contact" description="Contact the CVI Lab regarding prospective students, research collaboration, and general inquiries.">
  <section class="page-hero page-hero--compact">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow">Contact</p>
        <h1>Start a thoughtful conversation with our lab.</h1>
      </div>
      <p>Contact the CVI Lab regarding prospective students, research collaboration, and general inquiries.</p>
    </div>
  </section>

  <section class="section contact-section" aria-labelledby="contact-details-title">
    <div class="container contact-grid">
      <div class="contact-card">
        <p class="eyebrow">Laboratory details</p>
        <h2 id="contact-details-title">{site.officialName}</h2>
        <div class="contact-card__block">
          <h3>Institution</h3>
          <p>{site.institution}<br />{site.faculty}<br />{site.department}</p>
        </div>
        <div class="contact-card__block">
          <h3>Address</h3>
          <address>{site.address.map((line) => <>{line}<br /></>)}</address>
        </div>
        <div class="contact-card__block">
          <h3>Email</h3>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>

      <div class="inquiry-list">
        {inquiryTypes.map((inquiry) => (
          <article class="inquiry-card">
            <span>{inquiry.number}</span>
            <div>
              <h2>{inquiry.title}</h2>
              <p>{inquiry.text}</p>
              <Button href={`mailto:${site.email}?subject=${encodeURIComponent(inquiry.subject)}`} variant="text">Send an Email</Button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
