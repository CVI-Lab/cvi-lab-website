---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import ResearchAreaCard from '../components/ResearchAreaCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Tag from '../components/Tag.astro';
import { getPeople } from '../data/content';
import { pageCopy } from '../data/page-copy';
import { researchAreas } from '../data/research';
import { site } from '../data/site';
import { withBase } from '../utils/paths';

const { piBiography, piResearch, principalInvestigator } = await getPeople();
---

<BaseLayout title="About" description={`Learn about ${site.officialName}, its mission, research approach, and principal investigator.`}>
  <section class="page-hero page-hero--about">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow" data-inline-edit="pages:about.heroEyebrow">{pageCopy.about.heroEyebrow}</p>
        <h1 data-inline-edit="pages:about.heroTitle">{pageCopy.about.heroTitle}</h1>
      </div>
      <p data-inline-edit="site:aboutIntroduction.0">{site.aboutIntroduction[0]}</p>
    </div>
  </section>

  <section class="section about-overview" aria-labelledby="overview-title">
    <div class="container about-overview__grid">
      <div>
        <p class="eyebrow" data-inline-edit="pages:about.overviewEyebrow">{pageCopy.about.overviewEyebrow}</p>
        <h2 id="overview-title" data-inline-edit="pages:about.overviewTitle">{pageCopy.about.overviewTitle}</h2>
      </div>
      <div class="prose prose--large">
        {site.aboutIntroduction.slice(1).map((paragraph, index) => <p data-inline-edit={`site:aboutIntroduction.${index + 1}`}>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="mission-title">
    <div class="container">
      <div class="principles-grid">
        <article class="principle-card">
          <span class="principle-card__number">01</span>
          <p class="eyebrow" data-inline-edit="pages:about.missionEyebrow">{pageCopy.about.missionEyebrow}</p>
          <h2 id="mission-title" data-inline-edit="pages:about.missionTitle">{pageCopy.about.missionTitle}</h2>
          <p data-inline-edit="site:mission">{site.mission}</p>
        </article>
        <article class="principle-card">
          <span class="principle-card__number">02</span>
          <p class="eyebrow" data-inline-edit="pages:about.visionEyebrow">{pageCopy.about.visionEyebrow}</p>
          <h2 data-inline-edit="pages:about.visionTitle">{pageCopy.about.visionTitle}</h2>
          <p data-inline-edit="site:vision">{site.vision}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section about-themes" aria-labelledby="themes-title">
    <div class="container">
      <SectionHeading
        id="themes-title"
        eyebrow={pageCopy.about.themesEyebrow}
        title={pageCopy.about.themesTitle}
        intro={pageCopy.about.themesIntro}
        eyebrowEditKey="pages:about.themesEyebrow"
        titleEditKey="pages:about.themesTitle"
        introEditKey="pages:about.themesIntro"
      />
      <div class="research-stack">
        {researchAreas.map((area, index) => <ResearchAreaCard area={area} expanded editPrefix={`research:${index}`} />)}
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="approach-title">
    <div class="container approach-grid">
      <SectionHeading
        id="approach-title"
        eyebrow={pageCopy.about.approachEyebrow}
        title={pageCopy.about.approachTitle}
        eyebrowEditKey="pages:about.approachEyebrow"
        titleEditKey="pages:about.approachTitle"
      />
      <div class="prose">
        {site.researchApproach.map((paragraph, index) => <p data-inline-edit={`site:researchApproach.${index}`}>{paragraph}</p>)}
        <h3 data-inline-edit="pages:about.applicationTitle">{pageCopy.about.applicationTitle}</h3>
        <p data-inline-edit="site:applicationAreas">{site.applicationAreas}</p>
        <div class="tag-list tag-list--roomy" data-inline-edit="site:applicationTags" data-inline-format="lines">
          {site.applicationTags.map((tag) => <Tag>{tag}</Tag>)}
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pi-title">
    <div class="container pi-feature" data-content-type="person" data-content-id={principalInvestigator.id}>
      <ResponsiveImage
        src={principalInvestigator.avatar}
        alt="Illustrated portrait of Dr. Shan Du"
        aspect="portrait"
        placeholderLabel="PI portrait unavailable"
      />
      <div class="pi-feature__content">
        <p class="eyebrow">{pageCopy.about.piEyebrow}</p>
        <h2 id="pi-title">{principalInvestigator.name}</h2>
        <p class="pi-feature__role">{principalInvestigator.role}</p>
        {piBiography.map((paragraph) => <p>{paragraph}</p>)}
        <p>{piResearch}</p>
        <div class="pi-feature__actions">
          <Button href={withBase('/contact/')} variant="secondary">{pageCopy.about.contactAction}</Button>
          <a class="text-link" href={withBase('/people/')}>{pageCopy.about.peopleAction}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
