---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { joinContent } from '../data/join';
import { pageCopy } from '../data/page-copy';
import { site } from '../data/site';
import { withBase } from '../utils/paths';
---

<BaseLayout title="Join" description={`Explore student, researcher, and collaboration opportunities with ${site.officialName}.`}>
  <section class="page-hero page-hero--compact">
    <div class="container page-hero__grid">
      <div>
        <p class="eyebrow" data-inline-edit="pages:join.heroEyebrow">{pageCopy.join.heroEyebrow}</p>
        <h1 data-inline-edit="pages:join.heroTitle">{pageCopy.join.heroTitle}</h1>
      </div>
      <p data-inline-edit="site:joinShort">{site.joinShort}</p>
    </div>
  </section>

  <section class="section join-section" aria-labelledby="join-title">
    <div class="container join-section__grid">
      <div class="join-section__intro">
        <p class="eyebrow" data-inline-edit="pages:join.sectionEyebrow">{pageCopy.join.sectionEyebrow}</p>
        <h2 id="join-title" data-inline-edit="pages:join.sectionTitle">{pageCopy.join.sectionTitle}</h2>
        <p data-inline-edit="join:introduction">{joinContent.introduction}</p>
        <Button href={withBase('/contact/')}>{pageCopy.join.contactAction}</Button>
      </div>
      <div class="join-details">
        <details open>
          <summary data-inline-edit="pages:join.graduateTitle">{pageCopy.join.graduateTitle}</summary>
          <div><p data-inline-edit="join:graduate">{joinContent.graduate}</p></div>
        </details>
        <details>
          <summary data-inline-edit="pages:join.undergraduateTitle">{pageCopy.join.undergraduateTitle}</summary>
          <div><p data-inline-edit="join:undergraduate">{joinContent.undergraduate}</p></div>
        </details>
        <details>
          <summary data-inline-edit="pages:join.visitingTitle">{pageCopy.join.visitingTitle}</summary>
          <div><p data-inline-edit="join:visiting">{joinContent.visiting}</p></div>
        </details>
        <details>
          <summary data-inline-edit="pages:join.postdoctoralTitle">{pageCopy.join.postdoctoralTitle}</summary>
          <div><p data-inline-edit="join:postdoctoral">{joinContent.postdoctoral}</p></div>
        </details>
        <details>
          <summary data-inline-edit="pages:join.collaborationTitle">{pageCopy.join.collaborationTitle}</summary>
          <div><p data-inline-edit="join:collaboration">{joinContent.collaboration}</p></div>
        </details>
        <details>
          <summary data-inline-edit="pages:join.materialsTitle">{pageCopy.join.materialsTitle}</summary>
          <div>
            <div data-inline-edit="join:materials" data-inline-format="lines">
              <ul>{joinContent.materials.map((item) => <li>{item}</li>)}</ul>
            </div>
            <p><strong data-inline-edit="pages:join.emailSubjectLabel">{pageCopy.join.emailSubjectLabel}</strong><br /><code data-inline-edit="join:emailSubject">{joinContent.emailSubject}</code></p>
          </div>
        </details>
        <div class="availability-note">
          <strong data-inline-edit="pages:join.availabilityTitle">{pageCopy.join.availabilityTitle}</strong>
          <p data-inline-edit="join:availability">{joinContent.availability}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
