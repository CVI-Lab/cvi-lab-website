---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
  headingLevel?: 'h1' | 'h2';
  id?: string;
}

const { eyebrow, title, intro, align = 'left', headingLevel = 'h2', id } = Astro.props;
const Heading = headingLevel;
---

<header class:list={['section-heading', `section-heading--${align}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading id={id}>{title}</Heading>
  {intro && <p class="section-heading__intro">{intro}</p>}
</header>
