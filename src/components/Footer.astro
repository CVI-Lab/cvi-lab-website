---
import { navigation } from '../data/navigation';
import { pageCopy } from '../data/page-copy';
import { site } from '../data/site';
import { withBase } from '../utils/paths';

const currentYear = new Date().getFullYear();
const footerLinks = navigation.filter((item) => item.href !== '/' && item.label !== 'About');
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="brand brand--footer" href={withBase('/')} aria-label={`${site.name} home`}>
          <img
            class="brand__mark"
            src={withBase('/brand/cvi-lab-mark.svg')}
            alt=""
            width="82"
            height="87"
          />
          <span class="brand__wordmark" aria-hidden="true">
            <span class="brand__name">CVI Lab</span>
            <span class="brand__descriptor">Laboratory for Computational<br />Vision and Intelligence</span>
          </span>
        </a>
        <p data-inline-edit="pages:footer.tagline">
          {pageCopy.footer.tagline.split('\n').map((line) => <>{line}<br /></>)}
        </p>
      </div>

      <div class="site-footer__column">
        <h2 data-inline-edit="pages:footer.visitTitle">{pageCopy.footer.visitTitle}</h2>
        <address>
          {site.institution}<br />
          {site.faculty}<br />
          {site.department}<br /><br />
          <span data-inline-edit="site:address" data-inline-format="lines">
            {site.address.map((line) => <>{line}<br /></>)}
          </span>
        </address>
      </div>

      <div class="site-footer__column">
        <h2 data-inline-edit="pages:footer.navigateTitle">{pageCopy.footer.navigateTitle}</h2>
        <nav aria-label="Footer navigation">
          <ul>{footerLinks.map((item) => <li><a href={withBase(item.href)}>{item.label}</a></li>)}</ul>
        </nav>
      </div>

      <div class="site-footer__column">
        <h2 data-inline-edit="pages:footer.connectTitle">{pageCopy.footer.connectTitle}</h2>
        <a class="site-footer__email" href={`mailto:${site.email}`}>{site.email}</a>
        <a href="https://www.ubc.ca/" target="_blank" rel="noreferrer">{pageCopy.footer.ubcLink}</a>
        <p class="site-footer__placeholder" data-inline-edit="pages:footer.githubPlaceholder">{pageCopy.footer.githubPlaceholder}</p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {site.established}–{currentYear} {site.officialName}.</p>
      <p data-inline-edit="pages:footer.builtNote">{pageCopy.footer.builtNote}</p>
    </div>
  </div>
</footer>
