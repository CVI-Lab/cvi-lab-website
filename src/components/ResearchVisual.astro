---
import { withBase } from '../utils/paths';

interface Props {
  type: 'surface' | 'signal' | 'trust';
}

const { type } = Astro.props;
const visuals = {
  surface: {
    src: '/images/research/generative-3d-vision.webp',
    alt: 'A motion-capture studio with a performer, tracking cameras, a 3D face model, and a generated digital character on workstations.',
  },
  signal: {
    src: '/images/research/multimodal-perception.webp',
    alt: 'A multimodal analysis dashboard combining classroom vision, wildfire remote sensing, audio, thermal imagery, and an engagement heatmap.',
  },
  trust: {
    src: '/images/research/trustworthy-ai.webp',
    alt: 'A rainy street scene annotated with object detections, confidence scores, an attention heatmap, and grounded scene checks.',
  },
} as const;

const visual = visuals[type];
---

<div class:list={['research-visual', `research-visual--${type}`]}>
  <img src={withBase(visual.src)} alt={visual.alt} width="900" height="900" loading="lazy" decoding="async" />
</div>
