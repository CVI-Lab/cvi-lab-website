---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'text';
  external?: boolean;
  class?: string;
  ariaLabel?: string;
}

import { withBase } from '../utils/paths';

const {
  href,
  variant = 'primary',
  external = false,
  class: className,
  ariaLabel,
} = Astro.props;
const resolvedHref = withBase(href);
---

<a
  href={resolvedHref}
  class:list={['button', `button--${variant}`, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
  aria-label={ariaLabel}
>
  <slot />
  {external && <span class="sr-only"> (opens in a new tab)</span>}
  <svg class="button__icon" viewBox="0 0 20 20" aria-hidden="true">
    {external ? (
      <path d="M7 4h9v9M16 4 8.5 11.5M14.5 10.5v5h-10v-10h5" />
    ) : (
      <path d="m7 4.5 5.5 5.5L7 15.5M12 10H3.5" />
    )}
  </svg>
</a>
