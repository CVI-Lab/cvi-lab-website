---
import type { Project } from '../data/types';
import ResponsiveImage from './ResponsiveImage.astro';
import Tag from './Tag.astro';
import { withBase } from '../utils/paths';

interface Props {
  project: Project;
  priority?: boolean;
  orderGroup?: string;
}

const { project, priority = false, orderGroup } = Astro.props;
---

<article class="project-card" data-content-type="project" data-content-id={project.slug} data-order-group={orderGroup}>
  <a class="project-card__link" href={withBase(`/projects/${project.slug}/`)} aria-label={`View project: ${project.title}`}>
    <ResponsiveImage
      src={project.overviewImage}
      alt={project.imageAlt}
      eager={priority}
      placeholderLabel="Project image unavailable"
    />
    <div class="project-card__body">
      <div class="project-card__meta">
        <span>{project.venue} · {project.year}</span>
        {project.placeholderLabel && <span class="placeholder-label">{project.placeholderLabel}</span>}
      </div>
      <h3>{project.title}</h3>
      <p>{project.summary}</p>
      <div class="project-card__footer">
        <div class="tag-list" aria-label="Research tags">
          {project.tags.map((tag) => <Tag>{tag}</Tag>)}
        </div>
        <span class="project-card__arrow" aria-hidden="true">
          <svg viewBox="0 0 20 20"><path d="m7 4.5 5.5 5.5L7 15.5M12 10H3.5" /></svg>
        </span>
      </div>
    </div>
  </a>
</article>
