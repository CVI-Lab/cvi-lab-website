---
import type { Publication } from '../data/types';
import BibTeXBlock from './BibTeXBlock.astro';
import { withBase } from '../utils/paths';

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;
const titleHref = publication.projectSlug ? `/projects/${publication.projectSlug}/` : publication.projectUrl;
const resolvedTitleHref = titleHref ? withBase(titleHref) : undefined;
---

<article class="publication-entry">
  <div class="publication-entry__venue" aria-label={`${publication.venueShort ?? publication.venue}, ${publication.year}`}>
    <span>{publication.venueShort ?? publication.venue}</span>
  </div>
  <div class="publication-entry__content">
    <h3>
      {resolvedTitleHref ? <a href={resolvedTitleHref}>{publication.title}</a> : publication.title}
    </h3>
    <p class="publication-entry__reference">
      {publication.authors.join(', ')}. <span>{publication.venue}</span>{publication.pages ? `, ${publication.pages}` : ''}.
    </p>
    <div class="publication-entry__actions">
      <BibTeXBlock bibtex={publication.bibtex} />
      {publication.projectSlug && <a href={withBase(`/projects/${publication.projectSlug}/`)}>Project</a>}
      {publication.paperUrl && <a href={publication.paperUrl} target="_blank" rel="noreferrer">Paper ↗</a>}
      {publication.codeUrl && <a href={publication.codeUrl} target="_blank" rel="noreferrer">Code ↗</a>}
    </div>
  </div>
</article>
