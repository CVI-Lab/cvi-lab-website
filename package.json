{
  "name": "cvi-lab-website",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "start": "npm run dev",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build && npm run check:links",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "edit": "node scripts/content-editor.mjs",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "check:links": "node scripts/check-links.mjs",
    "content:new": "node scripts/new-content.mjs",
    "content:import-summary": "node scripts/import-paper-summary.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.1.6",
    "katex": "^0.18.3",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "cross-env": "^10.1.0",
    "typescript": "^5.9.2",
    "yaml": "^2.9.0"
  }
}
